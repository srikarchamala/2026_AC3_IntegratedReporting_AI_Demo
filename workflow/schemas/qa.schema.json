{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ac3-demo:qa",
  "title": "Independent source-grounded QA flags",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flags"
  ],
  "properties": {
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "category",
          "concern",
          "reference"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "concern": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
