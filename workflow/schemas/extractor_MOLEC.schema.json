{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ac3-demo:extraction:MOLEC",
  "title": "MOLEC source-grounded extraction",
  "description": "One report only. Every checklist field must appear; absent fields use explicit not_reported findings. No derived clinical classification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "document_name",
    "findings"
  ],
  "properties": {
    "source_id": {
      "const": "MOLEC"
    },
    "document_name": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "minItems": 18,
      "items": {
        "$ref": "#/$defs/finding"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "patient_identifier"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "patient_name"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "date_of_birth"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "specimen_identifier"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "specimen_description"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "accession_number"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "performing_lab"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "collection_date"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "report_date"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "report_status"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "reported_interpretation"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "limitations"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "clinical_history"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "assay_name"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "assay_scope"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "assay_method"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "result_summary"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "const": "coverage_or_sensitivity"
              }
            }
          },
          "minContains": 1
        }
      ]
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "field",
        "group_id",
        "value",
        "status",
        "units",
        "method",
        "denominator",
        "quote",
        "page"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MOLEC-[0-9]{3,}$"
        },
        "field": {
          "type": "string",
          "enum": [
            "patient_identifier",
            "patient_name",
            "date_of_birth",
            "specimen_identifier",
            "specimen_description",
            "accession_number",
            "performing_lab",
            "collection_date",
            "report_date",
            "report_status",
            "reported_interpretation",
            "limitations",
            "clinical_history",
            "other_reported_finding",
            "assay_name",
            "assay_scope",
            "assay_method",
            "result_summary",
            "gene",
            "variant",
            "transcript",
            "variant_type",
            "zygosity",
            "variant_allele_fraction",
            "reported_variant_tier",
            "reported_variant_significance",
            "reported_prognostic_statement",
            "reported_predictive_statement",
            "coverage_or_sensitivity"
          ]
        },
        "group_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "reported",
            "negative",
            "not_reported",
            "not_performed",
            "pending",
            "equivocal",
            "unreadable"
          ]
        },
        "units": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "denominator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "quote": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_reported"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "page": {
                "type": "null"
              },
              "quote": {
                "const": ""
              },
              "units": {
                "type": "null"
              },
              "method": {
                "type": "null"
              },
              "denominator": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "reported",
                  "negative",
                  "not_performed",
                  "pending",
                  "equivocal"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "reported",
                  "negative",
                  "equivocal"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ],
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unreadable"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
