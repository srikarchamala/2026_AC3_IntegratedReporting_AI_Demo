{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ac3-demo:integration",
  "title": "Source-grounded integrated report draft",
  "description": "Case findings and retrieved criteria have separate provenance. Structural validity is not clinical validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework",
    "classification_status",
    "criteria_assessment",
    "sections",
    "unresolved_issues"
  ],
  "properties": {
    "framework": {
      "type": "string",
      "minLength": 1
    },
    "classification_status": {
      "type": "string",
      "enum": [
        "supported",
        "insufficient_evidence",
        "out_of_scope"
      ]
    },
    "criteria_assessment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "patient_specimen"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "component_studies"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "clinical_context"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "morphology"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "flow"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "cytogenetics"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "molecular"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "interpretation"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "diagnosis"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "prognostic_predictive"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "sentences"
          ],
          "properties": {
            "id": {
              "const": "limitations"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sentences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sentence"
              }
            }
          }
        }
      ],
      "items": false
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification_status": {
            "const": "supported"
          }
        }
      },
      "then": {
        "properties": {
          "criteria_assessment": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "criterion",
        "source_id",
        "passage_id",
        "quote",
        "finding_ids",
        "assessment",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "passage_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assessment": {
          "type": "string",
          "enum": [
            "met",
            "not_met",
            "unknown",
            "not_applicable"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "finding_ids",
        "criterion_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "criterion_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "properties": {
            "finding_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "criterion_ids": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
